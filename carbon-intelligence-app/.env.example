# Copy to .env.local and fill in once a Supabase project exists.
# The app runs and the calculator is fully usable with these unset —
# only persistence (save/login/admin) is disabled until configured.

# Project Settings -> API in the Supabase dashboard
VITE_SUPABASE_URL=
# the "anon" public key — safe for client-side use, access is enforced
# by the Row Level Security policies in supabase/migrations
VITE_SUPABASE_ANON_KEY=
